<%= form_with(model: learning_log) do |form| %>
  <% if learning_log.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(learning_log.errors.count, "error") %> prohibited this learning_log from being saved:</h2>

      <ul>
        <% learning_log.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :learned_on, style: "display: block" %>
    <%= form.date_field :learned_on %>
  </div>

  <div>
    <%= form.label :duration_mins, style: "display: block" %>
    <%= form.number_field :duration_mins %>
  </div>

  <div>
    <%= form.label :memo, style: "display: block" %>
    <%= form.textarea :memo %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
